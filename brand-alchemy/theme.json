{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 2,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "760px",
      "wideSize": "1200px"
    },
    "color": {
      "custom": true,
      "customDuotone": false,
      "customGradient": true,
      "defaultPalette": false,
      "defaultGradients": false,
      "palette": [
        { "slug": "base", "color": "#0a0a0f", "name": "Charcoal" },
        { "slug": "base-soft", "color": "#101018", "name": "Charcoal Soft" },
        { "slug": "contrast", "color": "#f0f0f5", "name": "Off White" },
        { "slug": "muted", "color": "#a0a0b0", "name": "Muted Gray" },
        { "slug": "accent-gold", "color": "#ff9933", "name": "Saffron Gold" },
        { "slug": "accent-green", "color": "#00d26a", "name": "Emerald" }
      ]
    },
    "typography": {
      "fluid": true,
      "customFontSize": true,
      "lineHeight": true,
      "fontFamilies": [
        {
          "slug": "sans",
          "name": "Sans",
          "fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif"
        }
      ],
      "fontSizes": [
        { "slug": "small", "size": "0.9rem", "name": "Small" },
        { "slug": "medium", "size": "1.125rem", "name": "Medium" },
        { "slug": "large", "size": "clamp(1.5rem, 3vw, 2.25rem)", "name": "Large" },
        { "slug": "x-large", "size": "clamp(2.25rem, 5vw, 3.5rem)", "name": "X-Large" },
        { "slug": "xx-large", "size": "clamp(2.75rem, 7vw, 6rem)", "name": "XX-Large" }
      ]
    },
    "spacing": {
      "units": ["px", "rem", "em", "vh", "vw", "%"],
      "spacingScale": { "steps": 0 },
      "spacingSizes": [
        { "slug": "40", "size": "clamp(1.5rem, 4vw, 3rem)", "name": "Medium" },
        { "slug": "60", "size": "clamp(3rem, 8vw, 6rem)", "name": "Large" },
        { "slug": "80", "size": "clamp(5rem, 12vw, 10rem)", "name": "X-Large" }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--base)",
      "text": "var(--wp--preset--color--contrast)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--sans)",
      "fontSize": "var(--wp--preset--font-size--medium)",
      "lineHeight": "1.6"
    },
    "elements": {
      "link": {
        "color": { "text": "var(--wp--preset--color--accent-gold)" },
        ":hover": { "color": { "text": "var(--wp--preset--color--contrast)" } }
      },
      "h1": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)", "lineHeight": "1.02", "fontWeight": "800", "letterSpacing": "-0.03em" } },
      "h2": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)", "lineHeight": "1.1", "fontWeight": "700", "letterSpacing": "-0.02em" } },
      "h3": { "typography": { "fontSize": "var(--wp--preset--font-size--large)", "lineHeight": "1.2", "fontWeight": "700" } }
    }
  },
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" }
  ]
}
