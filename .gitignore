# Dependencies
node_modules/

# Vite / build caches
.vite/
*.local

# Standalone static build output (regenerated by `npm run build`)
/dist/

# ...but KEEP the built manifest under dist (enqueue.php reads it; dist is committed).
!brand-alchemy/assets/dist/.vite/
!brand-alchemy/assets/dist/.vite/manifest.json

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Env / secrets
.env
.env.*
!.env.example

# Private business data — never publish to the repo
Sales/

# Portfolio sites kept local-only (not yet published)
portfolio/ancient-combat-evolution/

# NOTE: brand-alchemy/assets/dist/ is intentionally COMMITTED so the theme is
# deployable without a build step. Do not ignore it.
