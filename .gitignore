# Dependencies
node_modules/

# Vite / build caches
.vite/
*.local

# Standalone static build output (regenerated by `npm run build`)
/dist/

# ...but KEEP the built manifest under dist (enqueue.php reads it; dist is committed).
!brand-alchemy/assets/dist/.vite/
!brand-alchemy/assets/dist/.vite/manifest.json

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Env / secrets
.env
.env.*
!.env.example

# Private business data — never publish (this repo is PUBLIC)
Sales/
Web-design agency/
deploy-scalable.ps1
deploy-scalable.sh
deploy-scalable-keyauth.ps1

# ACE site (portfolio/ace/) IS published and tracked.
# Keep only its heavy raw source footage out — the site ships processed assets
# in public/assets/, and `npm run media` can regenerate from local originals.
portfolio/ace/assets/*.mp4

# NOTE: brand-alchemy/assets/dist/ is intentionally COMMITTED so the theme is
# deployable without a build step. Do not ignore it.
